# Python
__pycache__/
*.pyc
*.pyo

# Embedding caches — regenerated by the demonstration, never committed.
# (The trained axis .npz under instrument/engine/results/ ARE committed.)
**/emb_*.npz
**/*_cache.npz

# Model weights — fetched from the HuggingFace Hub (sentence-transformers/LaBSE), never vendored.
**/models/
*.safetensors

# Environments, logs, OS cruft
venv/
.venv/
*.log
.DS_Store
